{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/artifact.js": { "maxDuration": 60 },
    "api/living.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/autonomy", "schedule": "17 1 * * *" },
    { "path": "/api/portfolio-events", "schedule": "37 1 * * *" }
  ],
  "rewrites": [
    { "source": "/api/spine", "destination": "/api/health?route=spine" },
    { "source": "/api/autonomy", "destination": "/api/health?route=autonomy" },
    { "source": "/api/autonomy/latest", "destination": "/api/health?route=autonomy-latest" },
    { "source": "/api/capabilities", "destination": "/api/meta?route=capabilities" },
    { "source": "/api/evidence", "destination": "/api/meta?route=evidence" },
    { "source": "/api/ecosystem-event", "destination": "/api/meta?route=ecosystem-event" },
    { "source": "/api/experiment-result", "destination": "/api/meta?route=experiment-result" },
    { "source": "/api/manifest", "destination": "/api/meta?route=manifest" },
    { "source": "/api/metrics", "destination": "/api/meta?route=metrics" },
    { "source": "/api/prime-experiment", "destination": "/api/meta?route=prime-experiment" },
    { "source": "/api/portfolio-events", "destination": "/api/living?route=portfolio-events" },
    { "source": "/api/readiness", "destination": "/api/meta?route=readiness" },
    { "source": "/api/status", "destination": "/api/meta?route=status" },
    { "source": "/api/v2", "destination": "/api/meta?route=v2" },
    { "source": "/api/verify", "destination": "/api/meta?route=verify" },
    { "source": "/api/version", "destination": "/api/meta?route=version" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ]
    }
  ]
}
