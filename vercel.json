{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "cleanUrls":  true,
    "functions":  {
                      "api/artifact.js":  {
                                              "maxDuration":  60
                                          },
                      "api/living.js":  {
                                            "maxDuration":  60
                                        }
                  },
    "crons":  [
                  {
                      "path":  "/api/autonomy",
                      "schedule":  "17 1 * * *"
                  },
                  {
                      "path":  "/api/portfolio-events",
                      "schedule":  "37 1 * * *"
                  }
              ],
    "rewrites":  [
                     {
                         "source":  "/card/(.*)",
                         "destination":  "/"
                     },
                     {
                         "source":  "/api/trust-relay",
                         "destination":  "/api/health?route=trust-relay"
                     },
                     {
                         "source":  "/api/portfolio-relay",
                         "destination":  "/api/health?route=portfolio-relay"
                     },
                     {
                         "source":  "/api/spine",
                         "destination":  "/api/health?route=spine"
                     },
                     {
                         "source":  "/api/autonomy",
                         "destination":  "/api/health?route=autonomy"
                     },
                     {
                         "source":  "/api/autonomy/latest",
                         "destination":  "/api/health?route=autonomy-latest"
                     },
                     {
                         "source":  "/api/capabilities",
                         "destination":  "/api/meta?route=capabilities"
                     },
                     {
                         "source":  "/api/evidence",
                         "destination":  "/api/meta?route=evidence"
                     },
                     {
                         "source":  "/api/evidence-lab",
                         "destination":  "/api/meta?route=evidence-lab"
                     },
                     {
                         "source":  "/api/ecosystem-event",
                         "destination":  "/api/meta?route=ecosystem-event"
                     },
                     {
                         "source":  "/api/experiment-result",
                         "destination":  "/api/meta?route=experiment-result"
                     },
                     {
                         "source":  "/api/manifest",
                         "destination":  "/api/meta?route=manifest"
                     },
                     {
                         "source":  "/api/metrics",
                         "destination":  "/api/meta?route=metrics"
                     },
                     {
                         "source":  "/api/prime-experiment",
                         "destination":  "/api/meta?route=prime-experiment"
                     },
                     {
                         "source":  "/api/portfolio-events",
                         "destination":  "/api/living?route=portfolio-events"
                     },
                     {
                         "source":  "/api/readiness",
                         "destination":  "/api/meta?route=readiness"
                     },
                     {
                         "source":  "/api/status",
                         "destination":  "/api/meta?route=status"
                     },
                     {
                         "source":  "/api/v2",
                         "destination":  "/api/meta?route=v2"
                     },
                     {
                         "source":  "/api/verify",
                         "destination":  "/api/meta?route=verify"
                     },
                     {
                         "source":  "/api/version",
                         "destination":  "/api/meta?route=version"
                     }
                 ],
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Strict-Transport-Security",
                                            "value":  "max-age=63072000; includeSubDomains; preload"
                                        },
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        },
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "Cross-Origin-Opener-Policy",
                                            "value":  "same-origin"
                                        },
                                        {
                                            "key":  "Cross-Origin-Resource-Policy",
                                            "value":  "same-origin"
                                        },
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; font-src \u0027self\u0027; img-src \u0027self\u0027 data:; connect-src \u0027self\u0027; object-src \u0027none\u0027; base-uri \u0027self\u0027; frame-ancestors \u0027none\u0027; form-action \u0027self\u0027; upgrade-insecure-requests"
                                        }
                                    ]
                    },
                    {
                        "source":  "/api/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, nofollow"
                                        }
                                    ]
                    },
                    {
                        "source":  "/prime",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "private, no-store, max-age=0"
                                        },
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, nofollow"
                                        }
                                    ]
                    },
                    {
                        "source":  "/reports",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "private, no-store, max-age=0"
                                        },
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, nofollow"
                                        }
                                    ]
                    },
                    {
                        "source":  "/api/prime/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "private, no-store, max-age=0"
                                        },
                                        {
                                            "key":  "Vary",
                                            "value":  "Authorization"
                                        },
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, nofollow"
                                        }
                                    ]
                    }
                ]
}