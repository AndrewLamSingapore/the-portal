{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/artifact.js": {
      "maxDuration": 60
    },
    "api/living.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/autonomy",
      "schedule": "17 1 * * *"
    },
    {
      "path": "/api/portfolio-events",
      "schedule": "37 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/card/(.*)",
      "destination": "/"
    },
    {
      "source": "/api/trust-relay",
      "destination": "/api/health?route=trust-relay"
    },
    {
      "source": "/api/portfolio-relay",
      "destination": "/api/health?route=portfolio-relay"
    },
    {
      "source": "/api/spine",
      "destination": "/api/health?route=spine"
    },
    {
      "source": "/api/autonomy",
      "destination": "/api/health?route=autonomy"
    },
    {
      "source": "/api/autonomy/latest",
      "destination": "/api/health?route=autonomy-latest"
    },
    {
      "source": "/api/capabilities",
      "destination": "/api/meta?route=capabilities"
    },
    {
      "source": "/api/evidence",
      "destination": "/api/meta?route=evidence"
    },
    {
      "source": "/api/evidence-lab",
      "destination": "/api/meta?route=evidence-lab"
    },
    {
      "source": "/api/ecosystem-event",
      "destination": "/api/meta?route=ecosystem-event"
    },
    {
      "source": "/api/experiment-result",
      "destination": "/api/meta?route=experiment-result"
    },
    {
      "source": "/api/manifest",
      "destination": "/api/meta?route=manifest"
    },
    {
      "source": "/api/metrics",
      "destination": "/api/meta?route=metrics"
    },
    {
      "source": "/api/prime-experiment",
      "destination": "/api/meta?route=prime-experiment"
    },
    {
      "source": "/api/portfolio-events",
      "destination": "/api/living?route=portfolio-events"
    },
    {
      "source": "/api/readiness",
      "destination": "/api/meta?route=readiness"
    },
    {
      "source": "/api/status",
      "destination": "/api/meta?route=status"
    },
    {
      "source": "/api/v2",
      "destination": "/api/meta?route=v2"
    },
    {
      "source": "/api/verify",
      "destination": "/api/meta?route=verify"
    },
    {
      "source": "/api/version",
      "destination": "/api/meta?route=version"
    },
    {
      "source": "/api/prime",
      "destination": "/api/meta?route=prime"
    },
    {
      "source": "/api/prime/report",
      "destination": "/api/meta?route=prime-report"
    },
    {
      "source": "/api/prime/publish",
      "destination": "/api/meta?route=prime-publish"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://vtrfgckzpjgtmqsnumur.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/prime",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://the-portal-ten.vercel.app"
        }
      ]
    },
    {
      "source": "/reports",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://the-portal-ten.vercel.app"
        }
      ]
    },
    {
      "source": "/api/prime/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Vary",
          "value": "Authorization"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/prime",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Vary",
          "value": "Authorization"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
