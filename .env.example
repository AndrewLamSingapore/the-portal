# Required for AI artifact generation
OPENAI_API_KEY=

# Optional: enables the durable shared archive and Stable Spine persistence
DATABASE_URL=

# Optional: enables curator-only promotion to historically verified
CURATOR_TOKEN=

# Required for authenticated PRIME result persistence and graph updates.
# Share only with the owner-controlled PRIME runtime; never expose in browser code.
PORTAL_RESULT_TOKEN=

# Required before /api/spine can be called. Keep server-side only.
PORTAL_SPINE_TOKEN=

# Portal autonomous loop. Disabled by default; enable only with DATABASE_URL configured.
PORTAL_AUTONOMY_ENABLED=0
# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>. Keep server-side only.
CRON_SECRET=

# Portal 6.3.1 Living Intelligence (preview/sandbox only)
# Explicitly enables living endpoints outside Vercel preview environments.
PORTAL_LIVING_SANDBOX=0
# Model-originated hypothesis populations require both this opt-in and OPENAI_API_KEY.
# Without either, the living sandbox deliberately falls back to deterministic seeded candidates.
PORTAL_LIVING_MODEL_ENABLED=0
# Optional model override. The default is the frontier gpt-5.6 model at high reasoning effort.
PORTAL_LIVING_MODEL=gpt-5.6
