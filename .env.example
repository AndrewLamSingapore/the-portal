# Required for AI artifact generation
OPENAI_API_KEY=

# Optional: enables the durable shared archive
DATABASE_URL=

# Optional: enables curator-only promotion to historically verified
CURATOR_TOKEN=

# Portal 6.3 Living Intelligence (preview/sandbox only)
# Explicitly enables living endpoints outside Vercel preview environments.
PORTAL_LIVING_SANDBOX=0
# Model-originated hypothesis populations additionally require OPENAI_API_KEY.
# Without it, the living sandbox deliberately falls back to deterministic seeded candidates.
