{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shared-design-language.local/reasoning-output-v1.schema.json",
  "title": "Shared Design Language Reasoning Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "confidence", "decision_summary", "schema_version"],
  "properties": {
    "kind": { "type": "string", "enum": ["recommendation", "proposed_action", "abstain"] },
    "recommendation": { "type": ["string", "null"] },
    "proposed_action": { "$ref": "./action-envelope-v1.schema.json" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "decision_summary": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "reasoner_version": { "type": "string" },
    "schema_version": { "const": "1.0" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "proposed_action" } } },
      "then": { "required": ["proposed_action"] }
    }
  ]
}
